// ============================================
// COMPLETE PRISMA SCHEMA FOR LMCS PLATFORM
// VERSION 3.0 - With Chercheur Integration
// ============================================
//
// Matches the full SQL database (create_complete_database.sql).
// See backend/COMPLETE_DATABASE_DOCUMENTATION.md for architecture.
//
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

// Chercheur Enums
enum Qualite {
  Enseignant_Chercheur  // Enseignant-Chercheur (hyphens become underscores)
  Chercheur
  Doctorant
}

enum GradeRecherche {
  Attache_de_recherche
  Charge_de_recherche
  Directeur_de_recherche
}

enum StatutChercheur {
  Actif
  Non_actif
}

// System User Enums
enum UserRole {
  ADMIN
  DIRECTOR
  TEACHER
  ASSISTANT
}

// Supervision Enums
enum SupervisionType {
  PFE
  MASTER
  PHD
  INTERNSHIP
  PROJECT
}

enum SupervisionStatus {
  IN_PROGRESS
  DEFENDED
  ABANDONED
  EXTENSION
  SUSPENDED
}

enum ValidationStatus {
  PENDING
  VALIDATED
  REJECTED
  REVISED
}

// ============================================
// MAIN MODELS
// ============================================

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text

  // Relationships
  chercheurs  Chercheur[]
  themes      Theme[]
  users       User[]  // Legacy relationship

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("teams")
}

model Theme {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text

  // Relationships
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  supervisions Supervision[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([teamId])
  @@map("themes")
}

model Chercheur {
  // Primary Key - ESI Matricule
  chercheur_id String @id @db.VarChar(50)

  // Basic Information
  nom_complet String @db.VarChar(255)

  // Contact Information
  mails String[]  // PostgreSQL array
  tel   String?   @db.VarChar(20)

  // Academic Background
  diplome               String? @db.VarChar(255)
  etablissement_origine String? @db.VarChar(255)

  // Professional Classification
  qualite         Qualite
  grade_recherche GradeRecherche?

  // Status
  statut StatutChercheur @default(Actif)

  // Research Metrics
  hindex Int @default(0)

  // Team Assignment
  equipe_id String?
  team      Team?   @relation(fields: [equipe_id], references: [id], onDelete: SetNull)

  // Online Presence
  url_dblp           String? @db.VarChar(500)
  url_google_scholar String? @db.VarChar(500)
  url_researchgate   String? @db.VarChar(500)
  url_site_personnel String? @db.VarChar(500)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  users                  User[]
  supervision_supervisors SupervisionSupervisor[]

  @@index([nom_complet])
  @@index([qualite])
  @@index([statut])
  @@index([equipe_id])
  @@index([qualite, statut])
  @@index([hindex(sort: Desc)])
  @@map("chercheurs")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String   // Hashed with bcrypt
  firstName   String
  lastName    String
  role        UserRole
  phoneNumber String?
  isActive    Boolean  @default(true)

  // Link to chercheur profile (optional)
  chercheur_id String?
  chercheur    Chercheur? @relation(fields: [chercheur_id], references: [chercheur_id], onDelete: SetNull)

  // Legacy team reference
  teamId      String?
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // Relationships
  validations ValidationLog[]
  auditLogs   AuditLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([chercheur_id])
  @@index([teamId])
  @@index([role, isActive])
  @@map("users")
}

model Student {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String?  @unique
  institution String
  level       String
  specialty   String?

  // Relationships
  supervisions Supervision[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([institution])
  @@index([level])
  @@index([lastName, firstName])
  @@map("students")
}

model Supervision {
  id              String            @id @default(uuid())
  title           String            @db.VarChar(500)
  type            SupervisionType
  description     String?           @db.Text
  status          SupervisionStatus @default(IN_PROGRESS)

  // Validation fields
  validationStatus ValidationStatus @default(PENDING)
  validatedAt      DateTime?
  validationNotes  String?          @db.Text

  academicYear    String
  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  keywords        String[]  // PostgreSQL array

  // Relationships
  studentId       String
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  themeId         String?
  theme           Theme?            @relation(fields: [themeId], references: [id], onDelete: SetNull)

  supervisors     SupervisionSupervisor[]
  validations     ValidationLog[]
  auditLogs       AuditLog[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([validationStatus])
  @@index([validationStatus, status])
  @@index([academicYear])
  @@index([studentId])
  @@index([themeId])
  @@index([academicYear, type])
  @@index([academicYear, validationStatus])
  @@index([startDate])
  @@index([validatedAt])
  @@index([updatedAt(sort: Desc)])
  @@map("supervisions")
}

model SupervisionSupervisor {
  id                  String      @id @default(uuid())

  // Foreign Keys
  supervisionId       String
  supervision         Supervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)

  supervisorId        String      @db.VarChar(50)  // References Chercheur.chercheur_id
  supervisor          Chercheur   @relation(fields: [supervisorId], references: [chercheur_id], onDelete: Cascade)

  // Additional fields
  contributionPercent Int         @default(100)
  isMainSupervisor    Boolean     @default(false)
  isExternal          Boolean     @default(false)

  createdAt           DateTime    @default(now())

  @@unique([supervisionId, supervisorId])
  @@index([supervisionId])
  @@index([supervisorId])
  @@index([supervisorId, isMainSupervisor])
  @@map("supervision_supervisors")
}

model ValidationLog {
  id            String           @id @default(uuid())

  // What was validated
  supervisionId String
  supervision   Supervision      @relation(fields: [supervisionId], references: [id], onDelete: Cascade)

  // Who validated it
  validatorId   String
  validator     User             @relation(fields: [validatorId], references: [id], onDelete: Cascade)

  // Validation details
  status        ValidationStatus
  comments      String?          @db.Text

  // What fields were checked
  fieldsChecked Json?

  // Issues found
  issues        Json?

  createdAt     DateTime         @default(now())

  @@index([supervisionId])
  @@index([validatorId])
  @@index([status])
  @@index([createdAt])
  @@index([validatorId, createdAt(sort: Desc)])
  @@index([supervisionId, createdAt(sort: Desc)])
  @@map("validation_logs")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entityType    String
  entityId      String?  @db.VarChar(255)  // Supports both UUID and chercheur_id
  changes       Json?
  ipAddress     String?  @db.VarChar(45)
  userAgent     String?  @db.Text

  // Relationships
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  supervisionId String?
  supervision   Supervision? @relation(fields: [supervisionId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([userId])
  @@index([supervisionId])
  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
