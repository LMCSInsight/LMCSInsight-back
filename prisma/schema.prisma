// ============================================
// COMPLETE PRISMA SCHEMA FOR LMCS PLATFORM
// VERSION 4.0
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Qualite {
  Enseignant_Chercheur @map("Enseignant-Chercheur")
  Chercheur
}

enum GradeRecherche {
  Attache_de_recherche   @map("Attache de recherche")
  Charge_de_recherche    @map("Charge de recherche")
  Directeur_de_recherche @map("Directeur de recherche")
}

enum StatutChercheur {
  Actif
  Non_actif @map("Non actif")
}

enum UserRole {
  ADMIN
  DIRECTOR
  RESEARCHER
  ASSISTANT
}

enum SupervisionType {
  PFE
  MASTER
  PHD
  INTERNSHIP
  PROJECT
}

enum SupervisionStatus {
  IN_PROGRESS
  DEFENDED
  ABANDONED
  EXTENSION
  SUSPENDED
}

enum ValidationStatus {
  PENDING
  VALIDATED
  REJECTED
  REVISED
}

enum Institution {
  ESI
  EXTERNE
}

enum StudentLevel {
  MASTER
  DOCTORANT
}

enum Specialty {
  SIL
  SID
  SIT
  SIQ
}

enum NotificationType {
  VALIDATION_DECISION
  NEW_SUBMISSION
  RESUBMISSION
}

// ============================================
// MAIN MODELS
// ============================================

model Team {
  id          String  @id @default(uuid())
  name        String  @unique
  description String? @db.Text
  themeId     String

  theme   Theme        @relation(fields: [themeId], references: [id], onDelete: Restrict)
  members Chercheur[]  @relation("TeamMembers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([themeId])
  @@map("teams")
}

model Theme {
  id          String  @id @default(uuid())
  name        String
  description String? @db.Text

  teams Team[]

  supervisions Supervision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("themes")
}

model Chercheur {
  chercheur_id String @id @db.VarChar(50)

  nom_complet String @db.VarChar(255)

  mails String[]
  tel   String?  @db.VarChar(20)

  diplome               String? @db.VarChar(255)
  etablissement_origine String? @db.VarChar(255)

  qualite         Qualite
  grade_recherche GradeRecherche?

  statut StatutChercheur @default(Actif)

  hindex Int @default(0)

  teams Team[] @relation("TeamMembers")

  url_dblp           String? @db.VarChar(500)
  url_google_scholar String? @db.VarChar(500)
  url_researchgate   String? @db.VarChar(500)
  url_site_personnel String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 1:1 inverse — one chercheur maps to at most one system user
  user                    User?
  supervision_supervisors SupervisionSupervisor[]

  @@index([nom_complet])
  @@index([qualite])
  @@index([statut])
  @@index([qualite, statut])
  @@index([hindex(sort: Desc)])
  @@map("chercheurs")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  role        UserRole
  phoneNumber String?
  isActive    Boolean  @default(true)

  // 1:1 link to chercheur profile
  chercheur_id String?    @unique
  chercheur    Chercheur? @relation(fields: [chercheur_id], references: [chercheur_id], onDelete: SetNull)

  validations   ValidationLog[]
  auditLogs     AuditLog[]
  notifications Notification[]

  /// Supervision records created in-app by this assistant (operational user).
  submittedSupervisions Supervision[] @relation("SupervisionSubmittedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
  @@index([chercheur_id])
  @@index([role, isActive])
  @@map("users")
}

model Student {
  id          String       @id @default(uuid())
  firstName   String
  lastName    String
  email       String       @unique
  institution Institution
  level       StudentLevel
  specialty   Specialty?

  deletedAt DateTime?

  supervisions Supervision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([institution])
  @@index([level])
  @@index([lastName, firstName])
  @@index([deletedAt])
  @@map("students")
}

model Supervision {
  id              String            @id @default(uuid())
  title           String            @db.VarChar(500)
  type            SupervisionType
  description     String?           @db.Text
  status          SupervisionStatus @default(IN_PROGRESS)

  validationStatus ValidationStatus @default(PENDING)
  validatedAt      DateTime?
  validationNotes  String?          @db.Text

  academicYear    String
  startDate       DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  keywords        String[]

  deletedAt DateTime?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  themeId String?
  theme   Theme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)

  submittedByUserId String?
  submittedBy         User?   @relation("SupervisionSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  supervisors    SupervisionSupervisor[]
  validations    ValidationLog[]
  auditLogs      AuditLog[]
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submittedByUserId])
  @@index([type])
  @@index([status])
  @@index([validationStatus])
  @@index([validationStatus, status])
  @@index([academicYear])
  @@index([studentId])
  @@index([themeId])
  @@index([academicYear, type])
  @@index([academicYear, validationStatus])
  @@index([startDate])
  @@index([validatedAt])
  @@index([updatedAt(sort: Desc)])
  @@index([deletedAt])
  @@map("supervisions")
}

model SupervisionSupervisor {
  id String @id @default(uuid())

  supervisionId String
  supervision   Supervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)

  supervisorId String    @db.VarChar(50)
  supervisor   Chercheur @relation(fields: [supervisorId], references: [chercheur_id], onDelete: Cascade)

  contributionPercent Int     @default(100)
  isMainSupervisor    Boolean @default(false)
  isExternal          Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([supervisionId, supervisorId])
  @@index([supervisionId])
  @@index([supervisorId])
  @@index([supervisorId, isMainSupervisor])
  @@map("supervision_supervisors")
}

model ValidationLog {
  id String @id @default(uuid())

  supervisionId String
  supervision   Supervision @relation(fields: [supervisionId], references: [id], onDelete: Cascade)

  validatorId String
  validator   User   @relation(fields: [validatorId], references: [id], onDelete: Cascade)

  status    ValidationStatus
  comments  String?          @db.Text

  fieldsChecked Json?
  issues        Json?

  createdAt DateTime @default(now())

  @@index([supervisionId])
  @@index([validatorId])
  @@index([status])
  @@index([createdAt])
  @@index([validatorId, createdAt(sort: Desc)])
  @@index([supervisionId, createdAt(sort: Desc)])
  @@map("validation_logs")
}

model AuditLog {
  id         String  @id @default(uuid())
  action     String
  entityType String
  entityId   String? @db.VarChar(255)
  changes    Json?
  ipAddress  String? @db.VarChar(45)
  userAgent  String? @db.Text

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  supervisionId String?
  supervision   Supervision? @relation(fields: [supervisionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([entityType])
  @@index([userId])
  @@index([supervisionId])
  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String           @db.Text
  readAt  DateTime?

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  supervisionId String?
  supervision   Supervision? @relation(fields: [supervisionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([recipientId])
  @@index([recipientId, readAt])
  @@index([supervisionId])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}
