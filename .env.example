DATABASE_URL="postgresql://postgres:password@localhost:5432/LMCSInsight"
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Parent folder `.env` (repo root) is loaded first; this file overrides. SMTP can live in either place.

# Outbound email (SMTP). If SMTP_HOST is unset, transactional emails are skipped (logged once in dev).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="LMCS Insight <noreply@example.com>"

# Public origin of the web app (no trailing slash). Logo img uses {APP_PUBLIC_URL}/lmcs.png unless MAIL_LOGO_URL is set.
# Local OK for backend links; real email clients usually cannot load images from http://localhost — use HTTPS in production.
APP_PUBLIC_URL="http://localhost:5173"

# Optional: full HTTPS URL to the logo PNG (public). Overrides APP_PUBLIC_URL/lmcs.png — best for CDN or strict asset URLs.
# MAIL_LOGO_URL="https://your-domain.example/lmcs.png"

# --- Gmail (smtp.gmail.com) ---
# Consumer Gmail rejects normal passwords over SMTP (EAUTH 535). Use an App Password:
# Google Account → Security → 2-Step Verification → App passwords → generate for “Mail”.
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
# SMTP_USER=your.account@gmail.com  SMTP_PASS=<16-char app password>
# MAIL_FROM should match that mailbox (e.g. Your Name <your.account@gmail.com>).
